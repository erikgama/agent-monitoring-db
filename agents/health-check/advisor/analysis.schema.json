{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "health_check_luna_decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "summary",
    "metric",
    "observed_value_seconds",
    "threshold_seconds",
    "evidence_quality",
    "safety_notes"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": ["alert", "no_alert", "inconclusive"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "metric": {"type": "string", "const": "p99_seconds"},
    "observed_value_seconds": {
      "type": ["number", "null"],
      "minimum": 0
    },
    "threshold_seconds": {"type": "number", "const": 2.0},
    "evidence_quality": {
      "type": "string",
      "enum": ["sufficient", "partial", "unavailable"]
    },
    "safety_notes": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    }
  }
}
