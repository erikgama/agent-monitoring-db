# Safe example only. Do not place real credentials in this file.
NOTIFICATION_DELIVERY_ENABLED=false
NOTIFICATION_EMAIL_FROM=alerts-account@example.invalid
NOTIFICATION_EMAIL_RECIPIENTS_WARNING=warning-recipient@example.invalid
NOTIFICATION_EMAIL_RECIPIENTS_CRITICAL=critical-recipient@example.invalid
NOTIFICATION_EMAIL_RECIPIENTS_REFACTOR=refactor-recipient@example.invalid
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=alerts-account@example.invalid
# SMTP_PASSWORD is injected only into Notification by the operator secret manager.
# For integrated Linux delivery, set a non-secret absolute helper reference:
# NOTIFICATION_SMTP_CREDENTIAL_HELPER=/opt/company/bin/notification-smtp-secret
SMTP_USE_STARTTLS=true
