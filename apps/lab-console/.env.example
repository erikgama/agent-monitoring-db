# Demo is isolated; for real infrastructure set integrated in BOTH deployments.
LAB_MODE=demo
LAB_ORIGIN=http://localhost:3000
LAB_API_URL=http://127.0.0.1:8000
LAB_RUNTIME=runtime
LAB_RETENTION_DAYS=14
# PostgreSQL password is local deployment configuration, never a MySQL credential.
LAB_POSTGRES_PASSWORD=replace-with-your-local-deployment-password
# No browser login. Integrated HTTP access is restricted to loopback.
# At least 32 random characters, same on API and runner. Keep out of Git.
LAB_RUNNER_KEY=
# Database profiles and LLM provider: ../../config/agent-monitoring.toml
